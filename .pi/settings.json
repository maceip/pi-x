{
  "defaultProvider": "mtplx",
  "defaultModel": "mtplx-flash-next-optimized-speed",
  "defaultThinkingLevel": "off",
  "modelThinkingLevels": {
    "mtplx/mtplx-flash-next-optimized-speed": "off",
    "mtplx/qwen3.8-flash-next-mlx-4bit": "off"
  },
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "sessionDir": ".pi/sessions",
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 24000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 1000,
    "provider": {
      "timeoutMs": 300000,
      "maxRetries": 0,
      "maxRetryDelayMs": 30000
    }
  },
  "extensions": [
    ".pi/extensions/*.ts"
  ],
  "skills": [
    ".pi/skills/*"
  ],
  "enableSkillCommands": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "transcript",
  "theme": "dark"
}
