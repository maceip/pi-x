# ==============================================================================
# pi-x Unified Configuration File
# Sourced automatically by start_mtplx.sh, run_agent.sh, and test_pi_setup.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Model Routing
# ------------------------------------------------------------------------------
export MTPLX_HOST="${MTPLX_HOST:-127.0.0.1}"
export MTPLX_PORT="${MTPLX_PORT:-8000}"
export MODEL_PATH="${MODEL_PATH:-/Users/mac/models/Qwen3.8-Flash-Next-MTPLX-Optimized-Speed}"
export MTPLX_MODEL_ID="${MTPLX_MODEL_ID:-mtplx-flash-next-optimized-speed}"
export MTPLX_CONTEXT_WINDOW="${MTPLX_CONTEXT_WINDOW:-65536}"
export MTPLX_PROFILE="${MTPLX_PROFILE:-turbo}"

# ------------------------------------------------------------------------------
# 2. Reasoning & Parser Settings
# ------------------------------------------------------------------------------
export MTPLX_REASONING="${MTPLX_REASONING:-off}"
export MTPLX_REASONING_PARSER="${MTPLX_REASONING_PARSER:-qwen3}"
export MTPLX_REASONING_EFFORT="${MTPLX_REASONING_EFFORT:-low}"

# ------------------------------------------------------------------------------
# 3. Cache & MTP Speculation Knobs
# ------------------------------------------------------------------------------
# SSD session caching (set to 'on' to cache prompt prefixes across agent turns)
export MTPLX_SSD_SESSION_CACHE="${MTPLX_SSD_SESSION_CACHE:-on}"
export MTPLX_SSD_MIN_PREFIX_TOKENS="${MTPLX_SSD_MIN_PREFIX_TOKENS:-512}"

# Speculative MTP draft depth (1-3)
export MTPLX_MTP_DEPTH="${MTPLX_MTP_DEPTH:-3}"
export MTPLX_MTP_HISTORY_POLICY="${MTPLX_MTP_HISTORY_POLICY:-committed}"

# ------------------------------------------------------------------------------
# 4. Metal Acceleration & Fusions
# ------------------------------------------------------------------------------
export MTPLX_QWEN4EXP_COMPILE="${MTPLX_QWEN4EXP_COMPILE:-1}"
export MTPLX_COMPILED_GDN="${MTPLX_COMPILED_GDN:-1}"
export MTPLX_AR_PIPELINE="${MTPLX_AR_PIPELINE:-1}"
export MTPLX_FUSED_GATE_UP="${MTPLX_FUSED_GATE_UP:-1}"
export MTPLX_FUSED_GDN_INPROJ="${MTPLX_FUSED_GDN_INPROJ:-1}"
export MTPLX_FUSED_GDN_CONVNORM="${MTPLX_FUSED_GDN_CONVNORM:-1}"
export MTPLX_FUSED_GDN_STEP="${MTPLX_FUSED_GDN_STEP:-1}"
export MTPLX_FUSED_HC_V3="${MTPLX_FUSED_HC_V3:-1}"
export MTPLX_FUSED_QSA_INDEXER="${MTPLX_FUSED_QSA_INDEXER:-1}"
export MTPLX_QSA_FLASH="${MTPLX_QSA_FLASH:-1}"
export MTPLX_QSA_POOLED_BITS="${MTPLX_QSA_POOLED_BITS:-8}"
export MTPLX_MTP_HISTORY_DEEP_CAP="${MTPLX_MTP_HISTORY_DEEP_CAP:-16384}"
export MTPLX_QSA_GATHER="${MTPLX_QSA_GATHER:-1}"
export MTPLX_QSA_PREFILL="${MTPLX_QSA_PREFILL:-1}"
export MTPLX_QSA_PREFILL_MIN_CONTEXT="${MTPLX_QSA_PREFILL_MIN_CONTEXT:-16384}"
export MTPLX_QSA_PREFILL_FLASH_MIN_CONTEXT="${MTPLX_QSA_PREFILL_FLASH_MIN_CONTEXT:-32768}"
export MTPLX_SYNC_AR="${MTPLX_SYNC_AR:-0}"
export MTPLX_NGRAM_RESIDENT="${MTPLX_NGRAM_RESIDENT:-0}"
export MTPLX_ENGINE_RAM_FRACTION="${MTPLX_ENGINE_RAM_FRACTION:-0.90}"
export MTPLX_ALLOW_OVERCOMMITTED="${MTPLX_ALLOW_OVERCOMMITTED:-1}"

# ------------------------------------------------------------------------------
# 5. Pi Coding Agent Settings
# ------------------------------------------------------------------------------
export PI_MODEL="${PI_MODEL:-mtplx-flash-next-optimized-speed}"
export PI_THINKING="${PI_THINKING:-off}"
export PI_TUI_MODE="${PI_TUI_MODE:-fullscreen}"

# Completion alert bell for long turns (>15s by default, set 0 to disable)
export PI_ENABLE_BELL="${PI_ENABLE_BELL:-1}"
export PI_BELL_THRESHOLD_S="${PI_BELL_THRESHOLD_S:-15}"

# Maximum server log size before automatic rotation (in megabytes)
export PI_MAX_LOG_SIZE_MB="${PI_MAX_LOG_SIZE_MB:-50}"
